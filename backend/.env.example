# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/pcps-connect
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/pcps-connect
MONGO_URI=mongodb://127.0.0.1:27017/pcps-connect

# Any long, random string -- used to sign JWTs. Change this to your own value.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session/cookie stays valid.
JWT_EXPIRES_IN=7d

# The exact origin your frontend runs on (Vite's default dev port is 5173).
CLIENT_ORIGIN=http://localhost:5173

# Port this backend listens on.
PORT=5000

# Cloudinary account credentials -- used to store event/club images in the
# cloud instead of the server's local disk (required in production, since
# most hosting platforms wipe local files on every redeploy).
# Free account: https://cloudinary.com -- these three values are on your
# Cloudinary dashboard immediately after signing up.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
