# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/pcps-connect
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/pcps-connect
MONGO_URI=mongodb://127.0.0.1:27017/pcps-connect

# Any long, random string -- used to sign JWTs. Change this to your own value.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session/cookie stays valid.
JWT_EXPIRES_IN=7d

# The exact origin your frontend runs on (Vite's default dev port is 5173).
CLIENT_ORIGIN=http://localhost:5173

# Port this backend listens on.
PORT=5000

# Cloudinary account credentials -- used to store event/club images in the
# cloud instead of the server's local disk (required in production, since
# most hosting platforms wipe local files on every redeploy).
# Free account: https://cloudinary.com -- these three values are on your
# Cloudinary dashboard immediately after signing up.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email sending (password reset links, contact form) -- uses Gmail SMTP.
# EMAIL_USER: the Gmail address emails are sent FROM.
# EMAIL_APP_PASSWORD: NOT your normal Gmail password. Generate one at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification
#   to be turned on for that Google account first). It's a 16-character
#   code Google generates specifically for apps like this one.
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# RENDER'S FREE TIER BLOCKS SMTP (ports 25/465/587), so the Gmail settings above
# cannot work there: emails (verification links, password resets) simply never
# leave. Use Brevo's HTTPS API instead -- free, 300 emails/day, no domain needed:
#   1. Sign up at https://www.brevo.com and verify your email.
#   2. Senders & IP -> Senders -> add the address emails should come from (your
#      Gmail works) and click the verification link Brevo emails you.
#   3. SMTP & API -> API Keys -> create a key (starts with "xkeysib-").
#   4. On Render (Environment) add BREVO_API_KEY, and BREVO_SENDER_EMAIL if the
#      verified sender is different from EMAIL_USER.
# When BREVO_API_KEY is set it is used instead of Gmail SMTP. Check it with
#   npm run test-email -- you@gmail.com
# BREVO_API_KEY=xkeysib-your-key
# BREVO_SENDER_EMAIL=your_verified_sender@gmail.com

# Where contact form submissions are sent. Defaults to EMAIL_USER above if
# not set -- override this once PCPS has a real staff inbox to use instead.
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Optional. The time zone event times are written in inside emails (reminders,
# confirmations, the weekly digest). Defaults to Asia/Kathmandu (Nepal time).
# EVENT_TIMEZONE=Asia/Kathmandu
